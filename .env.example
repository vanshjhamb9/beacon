APP_NAME="Beacon AI API"
APP_VERSION=0.1.0
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
API_PREFIX=/api/v1

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=beacon
POSTGRES_USER=beacon
POSTGRES_PASSWORD=beacon_password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS='["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://127.0.0.1:3000","http://127.0.0.1:3001","http://127.0.0.1:3002"]'

FEATURE_FLAGS__COLLECTORS_ENABLED=true
FEATURE_FLAGS__SOURCE_HEALTH_MONITORING_ENABLED=true
FEATURE_FLAGS__REQUEST_TRACING_ENABLED=true

COLLECTOR_STREAM_NAME=raw-events
COLLECTOR_CONSUMER_GROUP=raw-event-writers
COLLECTOR_CONSUMER_NAME=worker-1
COLLECTOR_STREAM_MAX_LENGTH=100000
COLLECTOR_PERSIST_BATCH_SIZE=50

REDDIT_COLLECTOR__ENABLED=true
REDDIT_COLLECTOR__SUBREDDITS='["startups","sales","marketing"]'
REDDIT_COLLECTOR__INTERVAL_SECONDS=300
REDDIT_COLLECTOR__MAX_ITEMS=25
REDDIT_COLLECTOR__RATE_LIMIT_PER_MINUTE=30

RSS_COLLECTOR__ENABLED=true
RSS_COLLECTOR__FEED_URLS='["https://techcrunch.com/feed/","https://www.theverge.com/rss/index.xml"]'
RSS_COLLECTOR__INTERVAL_SECONDS=300
RSS_COLLECTOR__MAX_ITEMS=25
RSS_COLLECTOR__RATE_LIMIT_PER_MINUTE=60

HACKER_NEWS_COLLECTOR__ENABLED=true
HACKER_NEWS_COLLECTOR__FEED_URLS='["https://hnrss.org/frontpage"]'
HACKER_NEWS_COLLECTOR__INTERVAL_SECONDS=180
HACKER_NEWS_COLLECTOR__MAX_ITEMS=30
HACKER_NEWS_COLLECTOR__RATE_LIMIT_PER_MINUTE=60

PRODUCT_HUNT_COLLECTOR__ENABLED=true
PRODUCT_HUNT_COLLECTOR__FEED_URLS='["https://www.producthunt.com/feed"]'
PRODUCT_HUNT_COLLECTOR__INTERVAL_SECONDS=600
PRODUCT_HUNT_COLLECTOR__MAX_ITEMS=25
PRODUCT_HUNT_COLLECTOR__RATE_LIMIT_PER_MINUTE=30
# ICE v1 — official Product Hunt GraphQL (required to resolve official websites; HTML is Cloudflare-blocked)
PRODUCT_HUNT_DEVELOPER_TOKEN=

GITHUB_TRENDING_COLLECTOR__ENABLED=true
# Optional — raises GitHub API rate limits for per-repo homepage recovery
GITHUB_TOKEN=
GITHUB_TRENDING_COLLECTOR__TOPICS='["saas","startup","artificial-intelligence","automation"]'
GITHUB_TRENDING_COLLECTOR__INTERVAL_SECONDS=300
GITHUB_TRENDING_COLLECTOR__MAX_ITEMS=25
GITHUB_TRENDING_COLLECTOR__RATE_LIMIT_PER_MINUTE=8

INDIE_HACKERS_COLLECTOR__ENABLED=true
INDIE_HACKERS_COLLECTOR__FEED_URLS='["https://www.indiehackers.com/feed.xml"]'
INDIE_HACKERS_COLLECTOR__INTERVAL_SECONDS=600
INDIE_HACKERS_COLLECTOR__MAX_ITEMS=25

SEC_EDGAR_COLLECTOR__ENABLED=true
SEC_EDGAR_COLLECTOR__INTERVAL_SECONDS=900
SEC_EDGAR_COLLECTOR__MAX_ITEMS=25
SEC_EDGAR_COLLECTOR__RATE_LIMIT_PER_MINUTE=10

DEVTO_COLLECTOR__ENABLED=true
DEVTO_COLLECTOR__FEED_URLS='["https://dev.to/feed"]'
DEVTO_COLLECTOR__INTERVAL_SECONDS=600
DEVTO_COLLECTOR__MAX_ITEMS=25

# Optional enrichment providers (website/DNS enrichment works without these)
BUILTWITH_API_KEY=
WAPPALYZER_API_KEY=
CRUNCHBASE_API_KEY=
ENRICHMENT_WEBSITE_FETCH_ENABLED=true
ENRICHMENT_DNS_LOOKUP_ENABLED=true

ACQUISITION_ALERT_FAILURE_THRESHOLD=3
ACQUISITION_HIGH_VALUE_OPPORTUNITY_SCORE=70

# Decision Maker Discovery — licensed people providers disabled by default
DECISION_DISCOVERY_LICENSED_PROVIDERS_ENABLED=false
APOLLO_API_KEY=
PEOPLE_DATA_LABS_API_KEY=

# AI Sales Copilot — grounded provider works without external LLM keys
SALES_COPILOT_PROVIDER=grounded
SALES_COPILOT_TEMPERATURE=0.2
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
GEMINI_MODEL=gemini-2.0-flash
OPENROUTER_MODEL=openrouter/auto

# Communication Gateway — sandbox by default; production send is double-gated
COMMUNICATION_MODE=sandbox
ALLOW_PRODUCTION_SEND=false
COMMUNICATION_ENCRYPTION_KEY=beacon-dev-only-change-me
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=
CALENDLY_API_KEY=
OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/communication/oauth/callback
DAILY_EMAIL_QUOTA=500
COMMUNICATION_MAX_RETRIES=5

# Target Account Intelligence — gates auto Sales Copilot + Campaign pipeline
TARGET_ACCOUNT_GATE_ENABLED=true
TARGET_ACCOUNT_TOP_TIER_THRESHOLD=70
TARGET_ACCOUNT_MID_TIER_THRESHOLD=50
TARGET_ACCOUNT_HUNTER_THRESHOLD=75
